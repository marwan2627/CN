
#include<stdio.h>
#include<conio.h>

void main()
{
    int path[10][6], i, j, min, a[6][6], p;
    int st=1, ed=5, stp, edp, t[10], index;

    clrscr();

    printf("Enter the cost matrix\n");

    for(i=1; i<=5; i++)
        for(j=1; j<=5; j++)
            scanf("%d", &a[i][j]);

    printf("Enter the paths\n");
    scanf("%d", &p);

    if(p<1 || p>9)
    {
        printf("Invalid number of paths");
        getch();
        return;
    }

    printf("Enter possible paths\n");

    for(i=1; i<=p; i++)
        for(j=1; j<=5; j++)
            scanf("%d", &path[i][j]);

    for(i=1; i<=p; i++)
    {
        t[i]=0;
        stp=st;

        for(j=1; j<=4; j++)
        {
            edp=path[i][j+1];

            t[i]=t[i]+a[stp][edp];

            if(edp==ed)
                break;
            else
                stp=edp;
        }
    }

    min=t[1];
    index=1;

    for(i=1; i<=p; i++)
    {
        if(min>t[i])
        {
            min=t[i];
            index=i;
        }
    }

    printf("\nMinimum cost %d", min);

    printf("\nMinimum cost path ");

    for(i=1; i<=5; i++)
    {
        printf("--> %d", path[index][i]);

        if(path[index][i]==ed)
            break;
    }

    getch();
}


