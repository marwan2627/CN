
#include<stdio.h>
#include<conio.h>
#include<string.h>

void main()
{
    char sender[50], receiver[50];
    int i, winsize, len;

    clrscr();

    printf("\nENTER THE WINDOW SIZE: ");
    scanf("%d", &winsize);

    printf("\nSENDER WINDOW IS EXPANDED TO STORE MESSAGE OR WINDOW");

    printf("\n\nENTER THE DATA TO BE SENT: ");
    fflush(stdin);
    gets(sender);

    len = strlen(sender);

    if(winsize < 1 || winsize > 49)
    {
        printf("\nInvalid window size");
        getch();
        return;
    }

    if(winsize > len)
        winsize = len;

    for(i = 0; i < winsize; i++)
        receiver[i] = sender[i];

    receiver[i] = '\0';

    printf("\n\nMESSAGE SENT BY THE SENDER:\n");
    puts(sender);

    printf("\nWINDOW SIZE OF RECEIVER IS EXPANDED");

    printf("\n\nACKNOWLEDGEMENT FROM RECEIVER\n");

    for(i = 0; i < winsize; i++)
    {
        printf("\nACK:%d", i + 1);
    }

    printf("\n\nMESSAGE RECEIVED BY RECEIVER IS: ");
    puts(receiver);

    printf("\nWINDOW SIZE OF RECEIVER IS SHRINKED");

    getch();
}


