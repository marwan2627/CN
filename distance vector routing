#include <stdio.h>

struct node
{
    unsigned d[20];
    unsigned f[20];
} r[20];

int main()
{
    int dm[20][20];
    int n, i, j, k, c = 0;

    printf("\nEnter the no. of nodes:");
    scanf("%d", &n);

    printf("Enter the cost matrix:\n");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            scanf("%d", &dm[i][j]);

            if (i == j)
                dm[i][j] = 0;

            r[i].d[j] = dm[i][j];
            r[i].f[j] = j;
        }
    }

    do
    {
        c = 0;

        for (i = 0; i < n; i++)
        {
            for (j = 0; j < n; j++)
            {
                for (k = 0; k < n; k++)
                {
                    if (r[i].d[j] > dm[i][k] + r[k].d[j])
                    {
                        r[i].d[j] = dm[i][k] + r[k].d[j];
                        r[i].f[j] = k;
                        c++;
                    }
                }
            }
        }
    }
    while (c != 0);

    for (i = 0; i < n; i++)
    {
        printf("\nState value for router %d is:\n", i + 1);

        for (j = 0; j < n; j++)
        {
            printf("\nNode: %d via: %d distance: %d",
                   j + 1, r[i].f[j] + 1, r[i].d[j]);
        }

        printf("\n");
    }

    return 0;
}

